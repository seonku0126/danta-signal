# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 공유·커밋하지 마세요.

# 키움 REST API (openapi.kiwoom.com 에서 발급, 서버 고정 IP 등록 필요)
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
# 시세 조회는 실전 서버(0) 권장. 주문 기능이 없어서 실전 키여도 매매는 일어나지 않습니다.
KIWOOM_MOCK=0

# 텔레그램: @BotFather 에서 받은 봇 토큰, 채널이면 @채널아이디 또는 -100으로 시작하는 숫자
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CHANNEL_NAME=단타 시그널
# 봇: @seonku_danta_signal_bot / 채널 ID는 --find-chat-id 로 확인

# 개장 시간이 다른 날(수능일, 연초 첫 거래일 등)만 바꾸세요
PREMARKET_TIME=08:55
OPEN_TIME=09:00
SCAN_MINUTES=10
FORCE_EXIT_TIME=15:20
REPORT_TIME=15:35
